<?xml version="1.0" encoding="utf-8"?>
<!-- Release: platform defaults. The debug source set replaces this file to also trust the
     corporate proxy CA used on the office network (see src/debug/res/xml). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
