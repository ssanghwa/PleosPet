<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pet_background"
    android:orientation="horizontal"
    android:padding="24dp">

    <!-- Scene: the dog runs here, speech bubble floats on top -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:clipToOutline="true">

        <com.example.test.pet.SceneryView
            android:id="@+id/scenery_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.test.pet.Dog3DView
            android:id="@+id/dog_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/speech_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_bubble"
            android:elevation="4dp"
            android:paddingHorizontal="36dp"
            android:paddingVertical="20dp"
            android:textColor="@color/pet_text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Shown when arriving home in the evening -->
        <LinearLayout
            android:id="@+id/dinner_card"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="150dp"
            android:background="@drawable/bg_bubble"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘 저녁 추천"
                android:textColor="@color/pet_accent"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dinner_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/pet_subtext"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/dinner_menus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/pet_text"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dinner_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/pet_text"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dinner_close"
                style="@style/PetActionButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="48dp"
                android:text="좋아요!" />
        </LinearLayout>
    </FrameLayout>

    <!-- Status card -->
    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- The owner's dog photo, once chosen -->
            <ImageView
                android:id="@+id/photo_view"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_avatar"
                android:clipToOutline="true"
                android:contentDescription="우리 강아지 사진"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pet_text"
                android:textSize="40sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/drive_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:textColor="@color/pet_text"
            android:textSize="24sp" />

        <!-- Look of the dog (P only) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/breed_button"
                style="@style/PetChipButton" />

            <TextView
                android:id="@+id/photo_button"
                style="@style/PetChipButton"
                android:layout_marginStart="12dp"
                android:text="사진 꾸미기" />

            <TextView
                android:id="@+id/reset_color_button"
                style="@style/PetChipButton"
                android:layout_marginStart="12dp"
                android:text="원래 색"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/fullness_label"
            style="@style/PetStatLabel"
            android:layout_marginTop="28dp"
            android:text="포만감" />

        <ProgressBar
            android:id="@+id/fullness_bar"
            style="@style/PetStatBar"
            android:progressTint="#F5A623" />

        <TextView
            style="@style/PetStatLabel"
            android:text="체력" />

        <ProgressBar
            android:id="@+id/energy_bar"
            style="@style/PetStatBar"
            android:progressTint="#4CAF50" />

        <TextView
            style="@style/PetStatLabel"
            android:text="행복" />

        <ProgressBar
            android:id="@+id/happiness_bar"
            style="@style/PetStatBar"
            android:progressTint="#F06292" />

        <TextView
            android:id="@+id/growth_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/pet_subtext"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/habit_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/pet_subtext"
            android:textSize="22sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/feed_button"
            style="@style/PetActionButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/snack_button"
            style="@style/PetActionButton"
            android:layout_marginTop="16dp"
            app:backgroundTint="@color/pet_button_snack" />

        <TextView
            android:id="@+id/park_hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="밥과 간식은 P단에서만 줄 수 있어요"
            android:textColor="@color/pet_subtext"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
